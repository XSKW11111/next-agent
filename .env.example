OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRODUCT_MATCH_THRESHOLD=0.30
MAX_PRODUCT_CANDIDATES=5
MAX_TOOL_ROUNDS=6
CONTEXT_WINDOW_TOKENS=128000
CONTEXT_HARD_TOKENS=120000
NEXT_AGENT_DEBUG_TOOL_DETAILS=false
# Every new chat turn writes a root run and step timings to LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=next-agent-local
# Optional safe trace ID and latency metadata in the server terminal. Forced off in production.
NEXT_AGENT_TERMINAL_OBSERVABILITY=true
